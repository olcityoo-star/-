# Скопируйте в .env и подставьте свои значения: cp .env.example .env

# --- Камера ---------------------------------------------------------------
# Одиночный снимок по HTTP (самый надёжный вариант, есть почти у всех камер):
#   CAMERA_URL=http://192.168.1.50/cgi-bin/snapshot.cgi
# Поток MJPEG:
#   CAMERA_URL=mjpeg:http://192.168.1.50:8080/video
# RTSP (нужен opencv из requirements-ml.txt):
#   CAMERA_URL=rtsp://192.168.1.50:554/stream1
# Без камеры, чтобы просто посмотреть систему:
CAMERA_URL=demo:
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_TIMEOUT=10

# --- Распознавание --------------------------------------------------------
# demo — нарисованная сцена, ничего ставить не нужно
# yolo — локальная модель, офлайн (pip install -r requirements-ml.txt)
# vlm  — мультимодальная модель по API, распознаёт больше всего продуктов
DETECTOR=demo

# для DETECTOR=yolo
DETECTOR_MODEL=yolov8n.pt
DETECTOR_CONFIDENCE=0.35

# для DETECTOR=vlm (подойдёт любой OpenAI-совместимый сервис)
VLM_API_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL=gpt-4o-mini

# --- Логика ---------------------------------------------------------------
# Как часто сама опрашивать камеру, секунды. 0 — только по кнопке и по датчику двери.
SCAN_INTERVAL=300
# Сколько кадров подряд должны показать изменение, прежде чем оно попадёт в список.
CONFIRMATIONS=2
KEEP_SNAPSHOTS=50

# --- Сервер ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
