# Скопируйте в .env и подставьте свои значения.
# Не коммитьте .env — там пароль от камеры.

# demo | yolo | ollama | openai
DETECTOR=demo

# Камера: HTTP-снимок или RTSP-поток
# Примеры:
#   http://192.168.1.20/snapshot.jpg
#   rtsp://192.168.1.20:554/stream1
CAMERA_URL=
CAMERA_USER=
CAMERA_PASSWORD=

# Локальная модель (нужен установленный Ollama + llava / moondream)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava

# Облачное зрение (опционально): OpenAI или совместимый endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Автоскан, секунды. 0 = только вручную
SCAN_INTERVAL_SECONDS=0

HOST=0.0.0.0
PORT=8080
